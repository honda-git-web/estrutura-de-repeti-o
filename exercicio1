import java.util.Scanner;

public class exercicio1 {
    static void main() {
        Scanner sc = new Scanner(System.in);

        int numero;
        int maior = Integer.MIN_VALUE;

        for (int i = 1; i <= 15; i++){
            System.out.println("Digite o número " + i + ":");
            numero = sc.nextInt();

            if (numero > maior){
                maior = numero;
            }
        }

        System.out.println("O maior número foi:" + maior);


    }
}
